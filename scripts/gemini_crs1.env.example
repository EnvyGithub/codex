# Gemini 推理翻译插件环境变量示例（用于 Codex “外部命令翻译钩子”）
#
# 使用方式（仅对当前终端会话生效）：
#   set -a
#   source /home/admin2/tmp/openai-codex/scripts/gemini_crs1.env
#   set +a
#
# 注意：
# - 不要把真实 API Key 提交到 git。
# - 建议把真实文件放在 ~/.codex/ 或其它私有目录，并设置权限 `chmod 600 <file>`。

# 你的 Gemini 代理 Base URL（不要包含 /models/...:generateContent）
CODEX_GEMINI_BASE_URL=https://ai.crs1.readwordx.com:3001/gemini/v1beta

# 你的模型 ID
CODEX_GEMINI_MODEL=gemini-3-flash-preview

# 单次翻译允许的最大输出 token 上限。
# 说明：部分 Gemini 代理在中文输出时 token 计数偏“紧”，默认 4096 更不容易截断长推理。
# CODEX_GEMINI_MAX_OUTPUT_TOKENS=4096

# 你的 API Key（请在真实文件里填写，不要填在这个 example 中）
# CODEX_GEMINI_API_KEY=YOUR_KEY
